# Settings of the updater container (compose.updater.yaml). Copy to updater.env, readable by the account that runs
# the containers only (chmod 600). Never in Git. One NAME=value per line, no quotes, no comment at the end of a line.

# GPT@EC key (settings: deploy/updater/settings.updater.yaml, built into the image).
OPENAI_API_KEY=

# Database: the same account, password and address as PostgREST (its PGRST_DB_URI), as a libpq URL. A password with
# special characters (@ : / ? # % $) must be percent-encoded, for example @ -> %40, $ -> %24.
TSI_DATABASE_URL=postgresql://<user>:<password>@<db-host>:5432/tsi_explorer?sslmode=require
# Schema of the explorer's tables (public if the tables are in public).
TSI_DB_SCHEMA=tsi_explorer
# Role taken for the load (set local role): service_role writes every row through the rules of 900_service_role.sql.
# The login account must be a member of it (grant service_role to <user>). Empty: the login account itself (owner).
TSI_DB_ROLE=service_role

# Outbound proxy of the host, if any. The database host and internal names go in NO_PROXY.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1
