# Copy this file to .env AT THE ROOT OF THE REPOSITORY, then fill it in.
# NEVER COMMIT .env (it is in .gitignore) and never copy a key into another file of the repository.
# A variable already set in the session's environment is not replaced by .env.

# Key of the LLM used by the update steps (openai mode of settings.yaml):
# key of the EC GPT gateway, or key of the OpenAI API if openai_base_url is empty.
OPENAI_API_KEY=

# Upload with the SDK (deploy\prod\upload.ps1), optional: API key of the Haystack Enterprise workspace,
# API URL of the client's platform. upload.ps1 reads these values from the environment of the PowerShell
# session (see deploy/updater/README.md, step 9, to load them from this file).
API_KEY=
API_URL=
DEFAULT_WORKSPACE_NAME=tsi-reform
