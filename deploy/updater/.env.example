# Copier ce fichier vers .env A LA RACINE DU DEPOT, puis le completer.
# NE JAMAIS COMMITER .env (il est dans .gitignore) ni copier une cle dans un autre fichier du depot.
# Une variable deja definie dans l'environnement de la session n'est pas remplacee par .env.

# Cle du LLM des etapes de mise a jour (mode openai de settings.yaml) :
# cle de la passerelle EC GPT, ou cle de l'API OpenAI si openai_base_url est vide.
OPENAI_API_KEY=

# Televersement par le SDK (deploy\prod\upload.ps1), facultatif : cle API du workspace Haystack Enterprise,
# URL de l'API de la plateforme du client. upload.ps1 lit ces valeurs dans l'environnement de la session
# PowerShell (voir deploy/updater/README.md, etape 9, pour les charger depuis ce fichier).
API_KEY=
API_URL=
DEFAULT_WORKSPACE_NAME=tsi-reform
